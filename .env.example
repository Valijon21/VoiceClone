# ==============================================================================
# VoiceClone AI Environment Variables Template
# ==============================================================================
# WARNING: NEVER commit real production passwords, keys, or secrets into git!
# Copy this file to '.env' for local development:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Web Backend Settings
# ------------------------------------------------------------------------------
DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=insecure-dev-secret-key-change-in-production-min-50-chars-random!
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=voiceclone
POSTGRES_USER=voiceclone_user
POSTGRES_PASSWORD=voiceclone_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://voiceclone_user:voiceclone_dev_password@127.0.0.1:5432/voiceclone

# ------------------------------------------------------------------------------
# 3. Redis & Celery Asynchronous Queue
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 4. AI Inference Service (FastAPI)
# ------------------------------------------------------------------------------
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8001
INFERENCE_BASE_URL=http://127.0.0.1:8001
INFERENCE_TIMEOUT_SECONDS=60
INFERENCE_DEVICE=cuda
INFERENCE_BOUNDED_CONCURRENCY=1
INFERENCE_MODEL_CACHE_DIR=./.cache/models

# ------------------------------------------------------------------------------
# 5. Media & Audio Storage
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
MEDIA_ROOT=./var/media
MAX_UPLOAD_AUDIO_SIZE_MB=15
MAX_REFERENCE_AUDIO_DURATION_SEC=30
MAX_TEXT_SYNTHESIS_CHARS=5000

# ------------------------------------------------------------------------------
# 6. Safety, Consent & Retention Policies
# ------------------------------------------------------------------------------
# In strict mode, audio cannot be synthesized without explicit user ConsentRecord
CONSENT_STRICT_MODE=True
AUDIO_RETENTION_DAYS=7
AUDIT_LOG_ENABLED=True
RATE_LIMIT_PER_MINUTE=10

# ------------------------------------------------------------------------------
# 7. Payment Gateways (VC-101: Payme & Click)
# ------------------------------------------------------------------------------
PAYME_MERCHANT_ID=mock_payme_merchant_id
PAYME_SECRET_KEY=mock_payme_secret_key
CLICK_SERVICE_ID=mock_click_service_id
CLICK_MERCHANT_ID=mock_click_merchant_id
CLICK_SECRET_KEY=mock_click_secret_key

